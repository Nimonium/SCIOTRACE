# Optional: Set your Google Gemini API Key for live AI generation.
# If omitted, Social Pulse AI will automatically use its built-in heuristic NLP and synthesizer fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to SQLite DB file (defaults to social_pulse.db in project root)
SQLITE_DB_PATH=social_pulse.db
